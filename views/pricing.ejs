<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TeleGraph - Telegram Bot Manager</title>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">

  <link rel="icon" href="/assets/logoImg.svg" type="image/x-icon" />
  <link rel="stylesheet" href="/css/animation.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body class="">

  <!-- Navbar with fixed positioning -->
  <div
    class="navbar bg-base-100 shadow-sm z-50 fixed top-0 left-0 right-0 px-4 sm:px-6"
  >
    <div class="navbar-start">
      <a
        href="/"
        class="btn btn-ghost text-xl flex items-center gap-2 whitespace-nowrap"
      >
        <img
          src="/assets/logoImg.svg"
          alt="TeleGraph logo"
          class="h-6 w-auto"
        />
        TeleGraph
      </a>
    </div>
    <div class="navbar-end">
  <div class="p-[1px] rounded-lg bg-gradient-to-r from-primary to-accent">
    <a href="/signin" class="btn bg-base-100 text-primary-content rounded-lg">
      Sign Up
    </a>
  </div>
    </div>
  </div>


  <!-- Pricing Section -->
  <section id="pricing" class="py-20 px-4 sm:px-6 relative overflow-hidden">

    <div class="blob absolute top-[-50px] left-[-50px]"></div>
    <div class="blob absolute bottom-[-50px] right-[-50px]"></div>

  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-6 scroll-reveal uppercase tracking-wide font-dancing">
      Simple, Transparent Pricing
    </h2>
    <div class="h-1 w-24 mx-auto bg-accent rounded scroll-reveal"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mt-10">

      <!-- Free Plan -->
      <div class="card bg-base-100 p-6 shadow scroll-reveal bg-gradient-telegraph w-full">
        <h3 class="text-2xl font-bold mb-2">Free Plan</h3>
        <p class="font-open mb-4">
          Ideal for individuals or small projects testing the platform. Manage up to 1 Telegram bot with basic monitoring and limited broadcast capacity. Enjoy secure single-user access and the ability to gather user feedback—all at no cost.
        </p>
        <p class="text-3xl font-bold my-4">$0</p>
        <ul class="mb-4 text-left">
          <li>✔ 1 Bot</li>
          <li>✔ Up to 100 Subscribers</li>
          <li>✔ Basic Analytics</li>
          <li>✔ Single-user Access</li>
        </ul>
        <button class="btn btn-accent btn-block w-full sm:w-auto">
          Get Started
        </button>
      </div>

      <!-- Pro Plan -->
      <div class="card bg-base-100 p-6 shadow border-accent border-2 scroll-reveal bg-gradient-telegraph-bottom w-full">
        <h3 class="text-2xl font-bold mb-2">Pro Plan</h3>
        <p class="font-open mb-4">
          Designed for growing projects and small businesses, this plan supports up to 5 Telegram bots and offers full bot monitoring, advanced analytics, and broadcast scheduling. Collaborate easily with teams of up to 5 members and receive priority customer support.
        </p>
        <p class="text-3xl font-bold my-4">$10/mo</p>
        <ul class="mb-4 text-left">
          <li>✔ Up to 5 Bots</li>
          <li>✔ 10,000 Subscribers</li>
          <li>✔ Advanced Analytics</li>
          <li>✔ Broadcast Scheduling & Templates</li>
          <li>✔ Team Collaboration (5 members)</li>
          <li>✔ Priority Support</li>
        </ul>
        <button class="btn btn-accent btn-block w-full sm:w-auto">Get Pro</button>
      </div>

      <!-- Agency Plan -->
      <div class="card bg-base-100 p-6 shadow scroll-reveal bg-gradient-telegraph3 w-full">
        <h3 class="text-2xl font-bold mb-2">Agency Plan</h3>
        <p class="font-open mb-4">
          Perfect for agencies and large teams needing scalable, comprehensive Telegram bot management. Enjoy unlimited bots and subscribers, advanced analytics, AI-powered features, and dedicated support with custom solutions tailored to your business needs.
        </p>
        <p class="text-3xl font-bold my-4">$75/mo</p>
        <ul class="mb-4 text-left">
          <li>✔ Unlimited Bots</li>
          <li>✔ Unlimited Subscribers</li>
          <li>✔ Advanced Analytics & AI Features</li>
          <li>✔ Unlimited Team Members</li>
          <li>✔ Dedicated Account Manager & Support</li>
          <li>✔ Custom Integrations & Features</li>
        </ul>
        <button class="btn btn-block btn-accent w-full sm:w-auto">
          Get started
        </button>
      </div>

    </div>
  </div>
</section>

  <!-- Footer -->
 <footer class="footer sm:footer-horizontal text-base-content p-10">
  <nav>
    <h6 class="footer-title">Company</h6>
    <a class="link link-hover">About us</a>
    <a class="link link-hover">Blog</a>
    <a class="link link-hover">Affiliate</a>
    <a href="/pricing" class="link link-hover">Pricing</a>
  </nav>
  <nav>
    <h6 class="footer-title">Legal</h6>
    <a class="link link-hover">Terms of use</a>
    <a class="link link-hover">Privacy policy</a>
    <a class="link link-hover">Cookie policy</a>
  </nav>
</footer>
