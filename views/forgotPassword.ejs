<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Telegraph | forgot password</title>
      <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css" />
     <link rel="stylesheet" href="/css/animation.css" />
     <script src="/js/forgotpassword.js" defer></script>
</head>
<body class="bg-base-200 flex flex-col items-center justify-center min-h-screen">

   <div role="alert" class="alert  alert-success w-1/2 hidden" id="alertbox">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <span>Email successfully sent!</span>
</div>

    <div class="card bg-base-100 shadow-lg p-8 w-full max-w-sm">
    <h2 class="text-3xl font-bold text-center mb-6  leading-tight bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent font-dancing">Forgot Password?</h2>

    <div class="space-y-4">
      <input id="username" type="text" placeholder="Username" class="input input-bordered w-full" />
      <input id="email" type="email" placeholder="Email" class="input input-bordered w-full" />
      <div class="flex w-full flex-col lg:flex-row" id="ConBtn">
      <button id="resetBtn" class="btn btn-primary lg:w-1/2">Generate reset link</button>
      </div>

    </div>  
  </div>


  <div class="toast toast-top toast-center hidden" id="toast"></div>

  <div class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden" id="loader">
  <span class="loading loading-infinity loading-xl absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-primary"></span>

</body>
</html>