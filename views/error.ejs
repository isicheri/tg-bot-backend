<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - TeleGraph</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="min-h-screen flex flex-col justify-center items-center bg-base-200 px-4 text-center">

  <div class="max-w-md w-full p-8 bg-base-100 shadow-lg rounded-xl border border-accent">
    
    <h1 class="text-4xl font-bold text-error mb-4">Oops!</h1>
    <p class="text-lg mb-2">Something went wrong.</p>
    
    <p class="text-sm text-gray-400 mb-6">
      <%= message || "An unexpected error occurred. Please try again later." %>
    </p>
    
    <a href="/" class="btn btn-accent w-full">Back to Home</a>
  </div>

</body>
</html>
