<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title class="leading-tight bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">Dashboard - TeleGraph</title>
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/animation.css" />
<script src="/js/apexcharts.min.js"></script>
</head>
<body class="min-h-screen flex md:overflow-hidden overflow-auto">

  <div class="drawer">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />
    
    <div class="drawer-content flex flex-col flex-1">
      <!-- Top Navbar -->
      <div class="navbar bg-base-100 shadow px-4 border-b border-neutral flex justify-between">
        <div class="flex items-center gap-2">
          <label for="my-drawer" class="btn btn-ghost md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <!-- <h1 class="text-xl font-bold hidden md:block">Dashboard</h1> -->
        </div>
        <div class="flex items-center gap-4">
          <p><%= username %></p>
         <div class="w-full sm:w-auto">
  <select id="botSelect" class="select select-bordered w-full sm:w-40">
    <option disabled selected>Select Bot</option>
  </select>
</div>
          <div class="avatar">
            <div class="mask mask-hexagon-2 w-10">
              <img src="<%= profilePic || '/assets/default-avatar.svg' %>" alt="Profile" />
            </div>
          </div>
        </div>
      </div>

      <div class="flex-1 flex flex-col p-6 space-y-6 overflow-auto md:ml-64">
        <!-- Main Content -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Summary Cards here -->
      <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Bot Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 2a2 2 0 012 2v2h-4V4a2 2 0 012-2z" />
                  <path d="M6 9h12v8a4 4 0 01-8 0H6v-8z" />
                  <circle cx="8.5" cy="14.5" r="1.5" />
                  <circle cx="15.5" cy="14.5" r="1.5" />
                </svg>
                <h2 class="text-sm text-gray-400">Total Bots</h2>
              </div>
              <p class="text-2xl font-bold" id="bot-count"></p>
            </div>
            <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Users Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="9" cy="7" r="4" />
                  <path d="M17 11v2a2 2 0 01-2 2H9a2 2 0 01-2-2v-2" />
                  <path d="M17 7a4 4 0 110 8" />
                </svg>
                <h2 class="text-sm text-gray-400">Total Subscribers</h2>
              </div>
              <p class="text-2xl font-bold" id="sub-count"></p>
            </div>
            <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Megaphone Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M3 11v2a1 1 0 001 1h3l6 4V7L7 11H4a1 1 0 00-1 1z" />
                </svg>
                <h2 class="text-sm text-gray-400">Recent Broadcasts</h2>
              </div>
              <p class="text-2xl font-bold" id="broadcastElCard"></p>
            </div>
            <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Team Users Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="7" cy="7" r="4" />
                  <circle cx="17" cy="7" r="4" />
                  <path d="M7 11v6a2 2 0 002 2h6" />
                  <path d="M17 13v4a2 2 0 01-2 2h-4" />
                </svg>
                <h2 class="text-sm text-gray-400">Teams</h2>
              </div>
              <p class="text-2xl font-bold" id="teamCardEL">2</p>
            </div>
            <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Message Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 11-3.8-11.4" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                <h2 class="text-sm text-gray-400">Messages Sent</h2>
              </div>
              <p class="text-2xl font-bold" id="message-count"></p>
            </div>
            <div class="card bg-base-100 shadow p-4 glass_div flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <!-- Trending Up Icon -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5 text-green-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline points="3 17 9 11 13 15 21 7" />
                </svg>
                <h2 class="text-sm text-gray-400">Growth Rate</h2>
                  <select id="growth-period" class="select select-bordered select-sm">
    <option value="week" selected>This Week vs Last</option>
    <option value="month">This Month vs Last</option>
    <option value="year">This Year vs Last</option>
  </select>
</div>
              <p class="text-2xl font-bold text-green-500" id="growth-rate-value">0%</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <!-- Analytics & Recent Broadcasts here -->
            <div class="card bg-base-100 shadow p-4  glass_div h-[290px]">
              <h2 class="text-lg font-bold mb-4">Analytics Overview</h2>
              <div class="h-64 flex justify-center items-center text-gray-400">
              <div id="subscriberChart" class="h-64 w-full"></div>
              </div>
            </div>

            <!-- Recent Broadcasts -->
            <div class="card bg-base-100 shadow p-4  glass_div">
              <h2 class="text-lg font-bold mb-4">Recent Broadcasts</h2>
              <div id="broadcast-list" class="space-y-2">
            
          
              </div>
            </div>


        </div>
      </div>
    </div>

    <!-- Mobile Sidebar -->
    <div class="drawer-side">
      <label for="my-drawer" class="drawer-overlay"></label>
      <ul class="menu bg-base-100 w-64 p-4 h-full overflow-auto">
        <div class="p-4 text-xl font-bold flex items-center gap-2 cursor-pointer">
          <img src="/assets/logoImg.svg" class="h-6" alt="Logo" /> 
           <h2 class="leading-tight bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">TeleGraph</h2>
        </div>
        <nav class="flex flex-col gap-2">
          <a href="/user/dashboard" class="btn justify-start flex items-center gap-2 <%= currentPage === 'dashboard' ? ' btn-primary' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1" ry="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" ry="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" ry="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" ry="1" />
            </svg>
            Dashboard
          </a>
          <!-- Repeat other links with SVGs -->
           
              <a
                href="/user/bots"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'bots' ? ' btn-primary' : '' %>"
              >
                <!-- Bot SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 2a2 2 0 012 2v2h-4V4a2 2 0 012-2z" />
                  <path d="M6 9h12v8a4 4 0 01-8 0H6v-8z" />
                  <circle cx="8.5" cy="14.5" r="1.5" />
                  <circle cx="15.5" cy="14.5" r="1.5" />
                </svg>
                Bots
              </a>

              <a
                href="/user/broadcast"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'broadcast' ? ' btn-primary' : '' %>"
              >
                <!-- Megaphone SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M3 11v2a1 1 0 001 1h3l6 4V7L7 11H4a1 1 0 00-1 1z" />
                </svg>
                Broadcast
              </a>

              <a
                href="/user/subscriber"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'subscriber' ? ' btn-primary' : '' %>"
              >
                <!-- Users SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="9" cy="7" r="4" />
                  <path d="M17 11v2a2 2 0 01-2 2H9a2 2 0 01-2-2v-2" />
                  <path d="M17 7a4 4 0 110 8" />
                </svg>
                Subscribers
              </a>

              <a
                href="/user/teams"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'teams' ? ' btn-primary' : '' %>"
              >
                <!-- Users-2 SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="7" cy="7" r="4" />
                  <circle cx="17" cy="7" r="4" />
                  <path d="M7 11v6a2 2 0 002 2h6" />
                  <path d="M17 13v4a2 2 0 01-2 2h-4" />
                </svg>
                Teams
              </a>

              <a
                href="/user/settings"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'settings' ? ' btn-primary' : '' %>"
              >
                <!-- Settings SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="3" />
                  <path
                    d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83l-1.42 1.42a2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2h-1a2 2 0 01-2-2v-1a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0L2.21 19.5a2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2v-1a2 2 0 012-2h1a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83l1.42-1.42a2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33h.06a1.65 1.65 0 001-1.51V3a2 2 0 012-2h1a2 2 0 012 2v1a1.65 1.65 0 001 1.51z"
                  />
                </svg>
                Settings
              </a>
        </nav>
      </ul>
    </div>
  </div>

  <!-- Desktop Sidebar -->
  <aside class="hidden md:flex w-64 bg-base-100 border-r border-r-neutral flex-col side_glass fixed top-0 left-0 h-full z-40">
    <div class="flex flex-col h-full">
      <div class="p-4 text-xl font-bold flex items-center gap-2 cursor-pointer">
        <img src="/assets/logoImg.svg" class="h-6" alt="Logo" /> 
        <h2 class="leading-tight bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">TeleGraph</h2>
      </div>
      <nav class="flex flex-col gap-2 p-4 h-[95vh] overflow-auto">
        <a href="/user/dashboard" class="btn justify-start flex items-center gap-2 <%= currentPage === 'dashboard' ? ' btn-primary' : '' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1" ry="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" ry="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" ry="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" ry="1" />
          </svg>
          Dashboard
        </a>
        <!-- Repeat other links with their corresponding SVGs as you had -->
         
              <a
                href="/user/bots"
                class="btn justify-start flex items-center gap-2 <%= currentPage === 'bots' ? ' btn-primary' : '' %>"
              >
                <!-- Bot SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 2a2 2 0 012 2v2h-4V4a2 2 0 012-2z" />
                  <path d="M6 9h12v8a4 4 0 01-8 0H6v-8z" />
                  <circle cx="8.5" cy="14.5" r="1.5" />
                  <circle cx="15.5" cy="14.5" r="1.5" />
                </svg>
                Bots
              </a>

              <a
                href="/user/broadcast"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'broadcast' ? ' btn-primary' : '' %>"
              >
                <!-- Megaphone SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M3 11v2a1 1 0 001 1h3l6 4V7L7 11H4a1 1 0 00-1 1z" />
                </svg>
                Broadcast
              </a>

              <a
                href="/user/subscriber"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'subscriber' ? ' btn-primary' : '' %>"
              >
                <!-- Users SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="9" cy="7" r="4" />
                  <path d="M17 11v2a2 2 0 01-2 2H9a2 2 0 01-2-2v-2" />
                  <path d="M17 7a4 4 0 110 8" />
                </svg>
                Subscribers
              </a>

              <a
                href="/user/teams"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'teams' ? ' btn-primary' : '' %>"
              >
                <!-- Users-2 SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="7" cy="7" r="4" />
                  <circle cx="17" cy="7" r="4" />
                  <path d="M7 11v6a2 2 0 002 2h6" />
                  <path d="M17 13v4a2 2 0 01-2 2h-4" />
                </svg>
                Teams
              </a>

              <a
                href="/user/settings"
                class="btn  justify-start flex items-center gap-2 <%= currentPage === 'settings' ? ' btn-primary' : '' %>"
              >
                <!-- Settings SVG -->
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="3" />
                  <path
                    d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83l-1.42 1.42a2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2h-1a2 2 0 01-2-2v-1a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0L2.21 19.5a2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2v-1a2 2 0 012-2h1a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83l1.42-1.42a2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33h.06a1.65 1.65 0 001-1.51V3a2 2 0 012-2h1a2 2 0 012 2v1a1.65 1.65 0 001 1.51z"
                  />
                </svg>
                Settings
              </a>
      </nav>
    </div>
  </aside>

  <script src="/js/dashboard.js"></script>
</body>
</html>
